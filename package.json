{
  "name": "employee-time-clock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:main": "vite",
    "dev:payroll-server": "cd payroll/server && npm run dev",
    "dev:payroll-client": "cd payroll/client && npm run dev",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:payroll-server\" \"npm run dev:payroll-client\"",
    "build:main": "vite build",
    "build:payroll-client": "cd payroll/client && npm run build",
    "build": "npm run build:main && npm run build:payroll-client && mkdir -p dist/payroll && cp -r payroll/client/dist/* dist/payroll/",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "@types/leaflet": "^1.9.21",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^5.0.0",
    "baseline-browser-mapping": "^2.9.18",
    "browserslist": "^4.28.1",
    "concurrently": "^8.2.2",
    "terser": "^5.46.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
